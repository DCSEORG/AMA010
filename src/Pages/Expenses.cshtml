@page
@model ExpenseManagement.Pages.ExpensesModel
@{
    ViewData["Title"] = "Expenses";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Expenses</h2>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label for="filter" class="form-label fw-bold">Filter:</label>
                <input type="text" class="form-control" id="filter" placeholder="Search expenses..." 
                       onkeyup="filterTable()" />
            </div>
            
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="expensesTable">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model.Expenses)
                        {
                            <tr>
                                <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                <td>@expense.CategoryName</td>
                                <td>@expense.FormattedAmount</td>
                                <td>
                                    @if (expense.StatusName == "Approved")
                                    {
                                        <span class="badge bg-success">@expense.StatusName</span>
                                    }
                                    else if (expense.StatusName == "Rejected")
                                    {
                                        <span class="badge bg-danger">@expense.StatusName</span>
                                    }
                                    else if (expense.StatusName == "Submitted")
                                    {
                                        <span class="badge bg-warning text-dark">@expense.StatusName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@expense.StatusName</span>
                                    }
                                </td>
                                <td>@expense.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="text-center mt-3">
                <button type="button" class="btn btn-primary" onclick="saveData()">Save</button>
            </div>
            
            <hr class="my-4" />
            
            <div class="d-flex gap-2 justify-content-center">
                <a href="/Index" class="btn btn-outline-secondary">Add Expense</a>
                <a href="/Approve" class="btn btn-outline-secondary">Approve Expenses</a>
            </div>
        </div>
    </div>
</div>

<script>
    function filterTable() {
        var input = document.getElementById("filter");
        var filter = input.value.toUpperCase();
        var table = document.getElementById("expensesTable");
        var tr = table.getElementsByTagName("tr");
        
        for (var i = 1; i < tr.length; i++) {
            var row = tr[i];
            var txtValue = row.textContent || row.innerText;
            if (txtValue.toUpperCase().indexOf(filter) > -1) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        }
    }
    
    function saveData() {
        alert("Data saved successfully!");
    }
</script>
